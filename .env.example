# Firebase (public — safe to expose to the browser; NEXT_PUBLIC_ vars are
# bundled into client-side JS)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Same-origin API by default (frontend and backend are unified in this
# app) — only set this to point at a different API origin.
# NEXT_PUBLIC_API_URL=/api

# Google Meet room (server-only). Never NEXT_PUBLIC_ — that would put the
# link in the browser bundle. Customers only receive it from the join
# endpoint once their meeting has started; staff via the dashboard.
# e.g. https://meet.google.com/abc-defg-hij
MEET_LINK=

# Public contact address shown as the "open your own mail app" fallback.
# Not a secret.
NEXT_PUBLIC_BUSINESS_EMAIL=

# MongoDB (server-only) — must point at the existing ProVisuell database,
# not a new/unrelated one. Either mongodb+srv://... or a standard
# mongodb://host1:port1,host2:port2,.../... connection string works. If you
# see "querySrv ECONNREFUSED" errors on API routes, your network/DNS can't
# do the SRV lookup mongodb+srv:// needs — get the standard (non-SRV)
# connection string from Atlas instead (Connect > Drivers > "Standard
# connection string" toggle) to bypass that entirely.
MONGO_URI=

# Firebase project ID, used server-side to verify Firebase ID tokens via
# Google's public JWKS endpoint (no service-account credential needed).
# Matches NEXT_PUBLIC_FIREBASE_PROJECT_ID above.
FIREBASE_PROJECT_ID=

# SMTP (Domene.no) — outgoing email: the public contact form, new
# order/booking/chat-message alerts to BUSINESS_EMAIL, and customer-facing
# confirmations. Everything goes through lib/mailer.js — until
# SMTP_HOST/SMTP_USER/SMTP_PASS are all set, sending is a silent no-op.
# Port 465 is implicit TLS.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

FROM_EMAIL=
BUSINESS_EMAIL=

# Base URL of this app (server-only) — used to build absolute links inside
# outgoing emails (invoice reminders, dashboard links). Set to the real
# production domain in production, e.g. https://provisuell.no
CLIENT_URL=http://localhost:3000

# Optional — printed on invoices if set, left blank otherwise.
SELLER_ORG_NUMBER=

# The one protected Super Admin (server-only). The first time this address
# signs in with a verified email, its Firebase UID is pinned in the database
# (SystemConfig "superadmin"); from then on only that UID is Super Admin,
# whatever any user's `role` field says. Defaults to abusiddik9994@gmail.com.
SUPER_ADMIN_EMAIL=abusiddik9994@gmail.com

# --- Notes & reminders ---------------------------------------------------
# Reminders are processed every minute by an in-process ticker on a normal
# `next start` server (see instrumentation.js / lib/notes/ticker.js). On a
# serverless host set NOTES_REMINDER_TICKER=off and call the cron route on a
# schedule instead:
#   curl -X POST -H "Authorization: Bearer $CRON_SECRET" https://<site>/api/notes/reminders/run
# Both can run at the same time safely (no duplicate reminders).
# CRON_SECRET must be at least 16 characters; leave empty if you don't use the route.
CRON_SECRET=
# NOTES_REMINDER_TICKER=off
# NOTES_REMINDER_INTERVAL_SECONDS=60

# Private storage for note attachments and voice notes (never under public/).
# Defaults to ./storage/private — point it at a persistent, backed-up disk.
# PRIVATE_STORAGE_DIR=
